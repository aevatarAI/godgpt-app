<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Central Package Management + deterministic restores:
    - Keep a single source to avoid ambiguous resolution across multiple feeds.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

