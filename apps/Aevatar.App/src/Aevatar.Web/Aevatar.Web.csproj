<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Aevatar.Web</RootNamespace>
    <AssetTargetFallback>$(AssetTargetFallback);portable-net45+win8+wp8+wpa81;</AssetTargetFallback>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <MvcRazorExcludeRefAssembliesFromPublish>false</MvcRazorExcludeRefAssembliesFromPublish>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
    <UserSecretsId>Aevatar.Web-4681b4fd-151f-4221-84a4-929d86723e4c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Pages\**\*.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Pages\**\*.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="Exists('./openiddict.pfx')">
    <None Remove="openiddict.pfx" />
    <EmbeddedResource Include="openiddict.pfx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Microsoft.Orleans.Client" />
    <PackageReference Include="Orleans.Providers.MongoDB" />
    <PackageReference Include="Orleans.Streams.Kafka" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aevatar.App.Application.Contracts\Aevatar.App.Application.Contracts.csproj" />
    <ProjectReference Include="..\Aevatar.App.Application\Aevatar.App.Application.csproj" />
    <ProjectReference Include="..\Aevatar.App.Domain.Shared\Aevatar.App.Domain.Shared.csproj" />
    <ProjectReference Include="..\Aevatar.App.Domain\Aevatar.App.Domain.csproj" />
    <ProjectReference Include="..\Aevatar.App.HttpApi\Aevatar.App.HttpApi.csproj" />
    <ProjectReference Include="..\Aevatar.App.MongoDB\Aevatar.App.MongoDB.csproj" />
    <ProjectReference Include="..\..\..\..\plugins\Aevatar.Agents.Plugins.CQRS\Aevatar.Agents.Plugins.CQRS.csproj" />
    <ProjectReference Include="..\..\..\..\plugins\Aevatar.Agents.Plugins.MassTransit\Aevatar.Agents.Plugins.MassTransit.csproj" />
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.Runtime.Local\Aevatar.Agents.Runtime.Local.csproj" />
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.Runtime.Orleans\Aevatar.Agents.Runtime.Orleans.csproj" />
    <PackageReference Include="Volo.Abp.Autofac" />
    <PackageReference Include="Volo.Abp.AutoMapper" />
    <PackageReference Include="Volo.Abp.Caching.StackExchangeRedis" />
    <PackageReference Include="Volo.Abp.Swashbuckle" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" />
    <PackageReference Include="Volo.Abp.Identity.Web" />
    <PackageReference Include="Volo.Abp.Account.Web.OpenIddict" />
    <PackageReference Include="Volo.Abp.SettingManagement.Web" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="Pages\SubscriptionFeatures\CreateModal.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\SubscriptionFeatures\EditModal.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\SubscriptionFeatures\Index.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\SubscriptionLabels\CreateModal.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\SubscriptionLabels\EditModal.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\SubscriptionLabels\Index.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\SubscriptionProducts\CreateModal.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\SubscriptionProducts\EditModal.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\SubscriptionProducts\Index.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\SubscriptionProducts\SetPriceModal.cshtml" />
  </ItemGroup>
