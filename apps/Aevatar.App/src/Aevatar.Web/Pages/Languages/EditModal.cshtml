@page
@using Aevatar.App.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Form
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model Aevatar.Web.Pages.Languages.EditModalModel
@inject IHtmlLocalizer<AevatarResource> L
@{
    Layout = null;
}

<form method="post" asp-page="/Languages/EditModal">
    <abp-modal>
        <abp-modal-header title="Edit Language"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Id" type="hidden" />
            @* <abp-input asp-for="Language.ConcurrencyStamp" type="hidden" /> *@
            <abp-input asp-for="Language.DisplayName" label="@L["DisplayName"].Value" />
            <abp-input asp-for="Language.IsEnabled" label="@L["IsEnabled"].Value" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>

