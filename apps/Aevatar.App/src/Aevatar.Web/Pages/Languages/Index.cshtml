@page
@using System.Text.Json
@using Aevatar.App.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Blockquote
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Button
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Card
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Grid
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Table
@using Volo.Abp.AspNetCore.Mvc.UI.Bundling.TagHelpers
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@model Aevatar.Web.Pages.Languages.IndexModel
@inject IHtmlLocalizer<AevatarResource> L
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L["Languages"].Value;
    PageLayout.Content.BreadCrumb.Add(L["Languages"].Value);
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>@L["Languages"]</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                @if (Model.CanCreate)
                {
                    <abp-button id="BtnCreateLanguage" 
                                button-type="Primary" 
                                icon="fas"
                                text="Create New Language">
                    </abp-button>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <form method="get" class="mb-3">
            <abp-row>
                <abp-column size-md="_4">
                    <div class="input-group">
                        <input type="text" name="Filter" class="form-control" 
                               placeholder="@L["Search"]..." value="@Model.Filter" />
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </abp-column>
            </abp-row>
        </form>
        
        <abp-table striped-rows="true">
            <thead>
                <tr>
                    <th style="width: 100px;">@L["Actions"]</th>
                    <th>@L["DisplayName"]</th>
                    <th>@L["CultureName"]</th>
                    <th>@L["UiCultureName"]</th>
                    <th>@L["IsEnabled"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var language in Model.Languages)
                {
                    <tr>
                        <td>
                            @if (Model.CanEdit || Model.CanDelete)
                            {
                                <div class="dropdown">
                                    <button class="btn btn-primary btn-sm dropdown-toggle" 
                                            type="button" 
                                            data-bs-toggle="dropdown" 
                                            aria-expanded="false">
                                        @L["Actions"]
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (Model.CanEdit)
                                        {
                                            <li>
                                                <a class="dropdown-item btn-edit" href="#" 
                                                   data-id="@language.Id">
                                                    <i class="fas fa-edit me-2"></i>@L["Edit"]
                                                </a>
                                            </li>
                                        }
                                        @if (Model.CanDelete)
                                        {
                                            <li>
                                                <a class="dropdown-item btn-delete text-danger" href="#" 
                                                   data-id="@language.Id"
                                                   data-name="@language.DisplayName">
                                                    <i class="fas fa-trash me-2"></i>@L["Delete"]
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </td>
                        <td>
                            <span class="fw-bold">@language.DisplayName</span>
                        </td>
                        <td>
                            <code>@language.CultureName</code>
                        </td>
                        <td>
                            <code>@language.UiCultureName</code>
                        </td>
                        <td>
                            @if (language.IsEnabled)
                            {
                                <span class="badge bg-success">@L["Enabled"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@L["Disabled"]</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </abp-table>
        
        @if (!Model.Languages.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-language fa-3x text-muted mb-3"></i>
                <p class="text-muted">@L["NoLanguagesFound"]</p>
            </div>
        }
    </abp-card-body>
</abp-card>

@section scripts {
    <script>
        $(function () {
            var localizedMessages = {
                deleteConfirmTitle: @Html.Raw(JsonSerializer.Serialize(L["DeleteLanguage"].Value)),
                deleteConfirmMessage: @Html.Raw(JsonSerializer.Serialize(L["DeleteLanguageConfirmMessage"].Value)),
                deleteSuccess: @Html.Raw(JsonSerializer.Serialize(L["LanguageDeletedSuccessfully"].Value))
            };

            var createModal = new abp.ModalManager(abp.appPath + 'Languages/CreateModal');
            var editModal = new abp.ModalManager(abp.appPath + 'Languages/EditModal');

            $('#BtnCreateLanguage').click(function (e) {
                e.preventDefault();
                createModal.open();
            });

            createModal.onResult(function () {
                location.reload();
            });

            $(document).on('click', '.btn-edit', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                editModal.open({ id: id });
            });

            editModal.onResult(function () {
                location.reload();
            });

            $(document).on('click', '.btn-delete', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var name = $(this).data('name');

                abp.message.confirm(
                    localizedMessages.deleteConfirmMessage.replace('{0}', name),
                    localizedMessages.deleteConfirmTitle
                ).then(function (confirmed) {
                    if (confirmed) {
                        abp.ajax({
                            url: abp.appPath + 'api/language-management/languages/' + id,
                            type: 'DELETE'
                        }).then(function () {
                            abp.notify.success(localizedMessages.deleteSuccess);
                            location.reload();
                        });
                    }
                });
            });
        });
    </script>
}
