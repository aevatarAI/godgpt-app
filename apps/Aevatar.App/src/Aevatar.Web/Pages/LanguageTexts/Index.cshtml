@page
@using Aevatar.App.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@model Aevatar.Web.Pages.LanguageTexts.IndexModel
@inject IHtmlLocalizer<AevatarResource> L
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L["LanguageTexts"].Value;
    PageLayout.Content.BreadCrumb.Add(L["LanguageManagement"].Value);
    PageLayout.Content.BreadCrumb.Add(L["LanguageTexts"].Value);
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>@L["LanguageTexts"]</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                @if (Model.CanCreate)
                {
                    <abp-button id="BtnCreateLanguageText" 
                                button-type="Primary" 
                                icon="fas"
                                text="Create New Language Text">
                    </abp-button>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <form method="get" class="mb-4">
            <abp-row class="mb-2">
                <abp-column size-md="_3">
                    <label class="form-label">@L["BaseCulture"]</label>
                    <select name="BaseCultureName" class="form-select">
                        @foreach (var culture in Model.Cultures)
                        {
                            <option value="@culture.Name" selected="@(Model.BaseCultureName == culture.Name)">
                                @culture.DisplayName
                            </option>
                        }
                    </select>
                </abp-column>
                <abp-column size-md="_3">
                    <label class="form-label">@L["TargetCulture"]</label>
                    <select name="TargetCultureName" class="form-select">
                        @foreach (var culture in Model.Cultures)
                        {
                            <option value="@culture.Name" selected="@(Model.TargetCultureName == culture.Name)">
                                @culture.DisplayName
                            </option>
                        }
                    </select>
                </abp-column>
                <abp-column size-md="_3">
                    <label class="form-label">@L["ResourceName"]</label>
                    <select name="ResourceName" class="form-select">
                        <option value="">@L["All"]</option>
                        @foreach (var resource in Model.Resources)
                        {
                            <option value="@resource.Name" selected="@(Model.ResourceName == resource.Name)">
                                @resource.Name
                            </option>
                        }
                    </select>
                </abp-column>
                <abp-column size-md="_3">
                    <label class="form-label">@L["TargetValue"]</label>
                    <select name="GetOnlyEmptyValues" class="form-select">
                        <option value="false" selected="@(!Model.GetOnlyEmptyValues)">@L["All"]</option>
                        <option value="true" selected="@(Model.GetOnlyEmptyValues)">@L["OnlyEmpty"]</option>
                    </select>
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_10">
                    <input type="text" name="Filter" class="form-control" 
                           placeholder="@L["SearchKeyOrValue"]..." value="@Model.Filter" />
                </abp-column>
                <abp-column size-md="_2">
                    <button class="btn btn-primary w-100" type="submit">
                        <i class="fas fa-search me-1"></i>@L["Search"]
                    </button>
                </abp-column>
            </abp-row>
        </form>
        
        <abp-table striped-rows="true">
            <thead>
                <tr>
                    <th style="width: 80px;"></th>
                    <th style="width: 200px;">@L["Key"]</th>
                    <th>@L["BaseValue"]</th>
                    <th>@L["Value"]</th>
                    <th style="width: 180px;">@L["ResourceName"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var text in Model.LanguageTexts)
                {
                    <tr>
                        <td>
                            @if (Model.CanEdit || Model.CanRestore)
                            {
                                <button type="button" class="btn btn-sm btn-primary btn-edit"
                                        data-resource-name="@text.ResourceName"
                                        data-culture-name="@text.CultureName"
                                        data-name="@text.Name"
                                        data-base-culture-name="@Model.BaseCultureName">
                                    @L["Edit"]
                                </button>
                            }
                        </td>
                        <td>
                            <code class="small">@text.Name</code>
                        </td>
                        <td>
                            <span class="text-muted">@text.BaseValue</span>
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(text.Value))
                            {
                                <span class="text-warning">
                                    <i class="fas fa-exclamation-triangle me-1"></i>@L["NotTranslated"]
                                </span>
                            }
                            else
                            {
                                <span>@text.Value</span>
                            }
                        </td>
                        <td>
                            <code class="small">@text.ResourceName</code>
                        </td>
                    </tr>
                }
            </tbody>
        </abp-table>
        
        @if (!Model.LanguageTexts.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                <p class="text-muted">@L["NoLanguageTextsFound"]</p>
            </div>
        }
        
        @if (Model.TotalCount > 0)
        {
            <div class="d-flex justify-content-between align-items-center mt-4">
                <div class="text-muted">
                    @L["TotalRecords"]: @Model.TotalCount
                    <span class="ms-3">|</span>
                    <span class="ms-3">@L["Page"] @Model.CurrentPage / @Model.TotalPages</span>
                </div>
                
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination mb-0">
                            @* Previous button *@
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Model.GetPageUrl(Model.CurrentPage - 1)" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                            
                            @* Page numbers *@
                            @{
                                var startPage = Math.Max(1, Model.CurrentPage - 2);
                                var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                                
                                if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Model.GetPageUrl(1)">1</a>
                                    </li>
                                    if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }
                                
                                for (var i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Model.GetPageUrl(i)">@i</a>
                                    </li>
                                }
                                
                                if (endPage < Model.TotalPages)
                                {
                                    if (endPage < Model.TotalPages - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" href="@Model.GetPageUrl(Model.TotalPages)">@Model.TotalPages</a>
                                    </li>
                                }
                            }
                            
                            @* Next button *@
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Model.GetPageUrl(Model.CurrentPage + 1)" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </abp-card-body>
</abp-card>

@section scripts {
    <script>
        $(function () {
            var createModal = new abp.ModalManager(abp.appPath + 'LanguageTexts/CreateModal');
            var editModal = new abp.ModalManager(abp.appPath + 'LanguageTexts/EditModal');

            $('#BtnCreateLanguageText').click(function (e) {
                e.preventDefault();
                createModal.open();
            });

            createModal.onResult(function () {
                location.reload();
            });

            $(document).on('click', '.btn-edit', function (e) {
                e.preventDefault();
                var resourceName = $(this).data('resource-name');
                var cultureName = $(this).data('culture-name');
                var name = $(this).data('name');
                var baseCultureName = $(this).data('base-culture-name');
                
                editModal.open({
                    resourceName: resourceName,
                    cultureName: cultureName,
                    name: name,
                    baseCultureName: baseCultureName
                });
            });

            editModal.onResult(function () {
                location.reload();
            });
        });
    </script>
}

