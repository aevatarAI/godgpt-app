@page
@using Aevatar.App.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Form
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model Aevatar.Web.Pages.LanguageTexts.CreateModalModel
@inject IHtmlLocalizer<AevatarResource> L
@{
    Layout = null;
}

<form method="post" asp-page="/LanguageTexts/CreateModal">
    <abp-modal>
        <abp-modal-header title="Create New Language Text"></abp-modal-header>
        <abp-modal-body>
            <div class="mb-3">
                <label class="form-label">@L["ResourceName"]</label>
                <select asp-for="LanguageText.ResourceName" class="form-select">
                    @foreach (var resource in Model.Resources)
                    {
                        <option value="@resource.Name">@resource.Name</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">@L["CultureName"]</label>
                <select asp-for="LanguageText.CultureName" class="form-select">
                    @foreach (var culture in Model.Cultures)
                    {
                        <option value="@culture.Name">@culture.DisplayName</option>
                    }
                </select>
            </div>
            <abp-input asp-for="LanguageText.Name" label="@L["Key"].Value" />
            <abp-input asp-for="LanguageText.Value" label="@L["Value"].Value" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>

