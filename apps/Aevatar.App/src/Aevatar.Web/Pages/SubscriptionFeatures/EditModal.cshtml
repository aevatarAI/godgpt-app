@page
@using Aevatar.App.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Form
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model Aevatar.Web.Pages.SubscriptionFeatures.EditModalModel
@inject IHtmlLocalizer<AevatarResource> L
@{
    Layout = null;
}

<form method="post" asp-page="/SubscriptionFeatures/EditModal">
    <abp-modal>
        <abp-modal-header title="@L["EditFeature"].Value"></abp-modal-header>
        <abp-modal-body>
            <input type="hidden" asp-for="Id" />
            <abp-input asp-for="Feature.NameKey" label="@L["NameKey"].Value" />
            <abp-input asp-for="Feature.DescriptionKey" label="@L["DescriptionKey"].Value" />
            
            <abp-select asp-for="Feature.Type" 
                        asp-items="Model.TypeOptions"
                        label="@L["FeatureType"].Value" />
            
            <abp-select asp-for="Feature.Usage" 
                        asp-items="Model.UsageOptions"
                        label="@L["Usage"].Value" />
            
            <abp-input asp-for="Feature.DisplayOrder" label="@L["DisplayOrder"].Value" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
