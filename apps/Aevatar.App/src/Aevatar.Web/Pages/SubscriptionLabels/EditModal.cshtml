@page
@using Aevatar.App.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Form
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model Aevatar.Web.Pages.SubscriptionLabels.EditModalModel
@inject IHtmlLocalizer<AevatarResource> L
@{
    Layout = null;
}

<form method="post" asp-page="/SubscriptionLabels/EditModal">
    <abp-modal>
        <abp-modal-header title="@L["EditLabel"].Value"></abp-modal-header>
        <abp-modal-body>
            <input type="hidden" asp-for="Id" />
            <abp-input asp-for="Label.Key" label="@L["LabelKey"].Value" info="snake_case format: lowercase letters, numbers, underscores (e.g., most_popular)" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
