@page
@using Aevatar.App.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Alert
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Blockquote
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Form
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Table
@model Aevatar.Web.Pages.SubscriptionProducts.EditModalModel
@inject IHtmlLocalizer<AevatarResource> L
@{
    Layout = null;
}

<form method="post" asp-page="/SubscriptionProducts/EditModal">
    <abp-modal>
        <abp-modal-header title="@L["EditProduct"].Value"></abp-modal-header>
        <abp-modal-body>
            <input type="hidden" asp-for="Id" />
            
            <abp-input asp-for="Product.NameKey" label="@L["NameKey"].Value" />
            <abp-select asp-for="Product.PlanType" 
                        asp-items="Model.PlanTypeOptions"
                        label="@L["PlanType"].Value" />
            <abp-input asp-for="Product.DescriptionKey" label="@L["DescriptionKey"].Value" />
            <abp-input asp-for="Product.HighlightKey" label="@L["HighlightKey"].Value" />
            
            <div class="mb-3">
                <label class="form-label">@L["Platform"]</label>
                <input type="text" class="form-control" value="@Model.GetPlatformDisplayName(Model.Product.Platform)" readonly disabled />
            </div>
            
            <div class="mb-3">
                <label class="form-label">@L["PlatformProductId"]</label>
                <input type="text" class="form-control" value="@Model.Product.PlatformProductId" readonly disabled />
            </div>
            
            <div class="mb-3">
                <label class="form-label">@L["Features"]</label>
                <div class="border rounded p-2" id="featuresContainer">
                    @{
                        var featureIndex = 0;
                        var collapsedCount = 5;
                    }
                    @foreach (var feature in Model.AvailableFeatures)
                    {
                        var isHidden = featureIndex >= collapsedCount;
                        <div class="form-check feature-item @(isHidden ? "d-none feature-collapsed" : "")">
                            <input class="form-check-input" 
                                   type="checkbox" 
                                   name="Product.FeatureIds" 
                                   value="@feature.Value" 
                                   id="feature_@featureIndex"
                                   @(feature.Selected ? "checked" : "") />
                            <label class="form-check-label" for="feature_@featureIndex">
                                @feature.Text
                            </label>
                        </div>
                        featureIndex++;
                    }
                </div>
                @if (Model.AvailableFeatures.Count > collapsedCount)
                {
                    <button type="button" class="btn btn-link btn-sm p-0 mt-1" id="toggleFeaturesBtn" onclick="toggleFeatures()">
                        <i class="fas fa-chevron-down" id="toggleIcon"></i>
                        <span id="toggleText">@L["ShowAll"] (@Model.AvailableFeatures.Count)</span>
                    </button>
                }
            </div>
            
            <script>
                var featuresExpanded = false;
                var collapseText = @Html.Raw(Json.Serialize(L["Collapse"].Value));
                var showAllText = @Html.Raw(Json.Serialize(L["ShowAll"].Value)) + ' (@Model.AvailableFeatures.Count)';
                
                function toggleFeatures() {
                    featuresExpanded = !featuresExpanded;
                    var collapsedItems = document.querySelectorAll('.feature-collapsed');
                    var toggleText = document.getElementById('toggleText');
                    var toggleIcon = document.getElementById('toggleIcon');
                    
                    collapsedItems.forEach(function(item) {
                        if (featuresExpanded) {
                            item.classList.remove('d-none');
                        } else {
                            item.classList.add('d-none');
                        }
                    });
                    
                    if (featuresExpanded) {
                        toggleText.textContent = collapseText;
                        toggleIcon.className = 'fas fa-chevron-up';
                    } else {
                        toggleText.textContent = showAllText;
                        toggleIcon.className = 'fas fa-chevron-down';
                    }
                }
            </script>
            
            <abp-select asp-for="Product.LabelId" 
                        asp-items="Model.AvailableLabels"
                        label="@L["Label"].Value" />
            
            <abp-input asp-for="Product.IsUltimate" label="@L["IsUltimate"].Value" />
            
            <abp-input asp-for="Product.DisplayOrder" label="@L["DisplayOrder"].Value" />
            
            @if (Model.IsStripePlatform)
            {
                <hr />
                <h6>@L["Prices"]</h6>
                @if (Model.Prices.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>@L["Currency"]</th>
                                    <th>@L["Price"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var price in Model.Prices)
                                {
                                    <tr>
                                        <td><code>@price.Currency</code></td>
                                        <td>@price.Price.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted"><em>@L["PricesNotSynced"]</em></p>
                }
            }
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
