@page
@using Aevatar.App.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Form
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model Aevatar.Web.Pages.SubscriptionProducts.CreateModalModel
@inject IHtmlLocalizer<AevatarResource> L
@{
    Layout = null;
}

<form method="post" asp-page="/SubscriptionProducts/CreateModal">
    <abp-modal>
        <abp-modal-header title="@L["CreateProduct"].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Product.NameKey" label="@L["NameKey"].Value" />
            <abp-select asp-for="Product.PlanType" 
                        asp-items="Model.PlanTypeOptions"
                        label="@L["PlanType"].Value" />
            <abp-input asp-for="Product.DescriptionKey" label="@L["DescriptionKey"].Value" />
            <abp-input asp-for="Product.HighlightKey" label="@L["HighlightKey"].Value" />
            
            <abp-select asp-for="Product.Platform" 
                        asp-items="Model.PlatformOptions"
                        label="@L["Platform"].Value" />
            
            <abp-input asp-for="Product.PlatformProductId" label="@L["PlatformProductId"].Value" />
            
            <div class="mb-3">
                <label class="form-label">@L["Features"]</label>
                <select asp-for="Product.FeatureIds" 
                        asp-items="Model.AvailableFeatures"
                        class="form-select" 
                        multiple="multiple">
                </select>
            </div>
            
            <abp-select asp-for="Product.LabelId" 
                        asp-items="Model.AvailableLabels"
                        label="@L["Label"].Value" />
            
            <abp-input asp-for="Product.IsUltimate" label="@L["IsUltimate"].Value" />
            
            <abp-input asp-for="Product.DisplayOrder" label="@L["DisplayOrder"].Value" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
