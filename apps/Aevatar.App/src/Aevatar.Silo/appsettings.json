{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Orleans": "Information",
      "Orleans.Runtime": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "AwsS3": {
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Region": "ap-northeast-1",
    "ContainerName": "godgpt-backend-staging"
  },
  
  "ConnectionStrings": {
    "Orleans": "mongodb://localhost:27017/AevatarBusiness"
  },
  
  "AgentRuntime": {
    "RuntimeType": "Orleans",
  "Orleans": {
    "ClusterId": "aevatar-cluster",
    "ServiceId": "aevatar-service",
    "SiloPort": 11111,
    "GatewayPort": 30000
    }
  },
  
  "Storage": {
    "Provider": "MongoDB",
    "DatabaseName": "AevatarBusiness"
  },

  "MessageStream": {
    "Provider": "MassTransit"
  },
  "MassTransit": {
    "Stream": {
      "TopicPrefix": "agent-events",
      "TransportType": "Kafka",
      "RuntimeName": "Orleans",
      "TopicMapping": {
        "GodChat": "godgpt-chat-responses"
      },
      "Consumer": {
        "Enabled": true,
        "DispatchHandler": "GrainHandler",
        "IncludeTopicPrefix": true,
        "AutoScanAgentTopics": true
      },
      "CQRS": {
        "Enabled": true,
        "MessageTtlSeconds": 3600,
        "EnableDeduplication": true
      },
      "Kafka": {
        "BootstrapServers": "localhost:9092",
        "ConsumerGroupId": "aevatar-agents-group"
      }
    }
  },
  
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  
  "EventSourcing": {
    "Enabled": true,
    "SnapshotFrequency": 10,
    "Provider": "MongoDB"
  },
  
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexPrefix": "aevatar-state",
    "Username": "",
    "Password": ""
  },
  
  "CQRS": {
    "Projector": {
      "BatchSize": 50,
      "MaxBatchSize": 200,
      "FlushIntervalMs": 1000,
      "MaxRetryCount": 3
    }
  },
  
  "Speech": {
    "SubscriptionKey": "",
    "Region": "southeastasia",
    "Endpoint": "https://eastus.api.cognitive.microsoft.com/"
  },
  
  "AnonymousGodGPT": {
    "MaxChatCount": 100,
    "Enabled": true
  },
  
  "RateLimit": {
    "UserMaxRequests": 100,
    "UserTimeWindowSeconds": 10800,
    "SubscribedUserMaxRequests": 500,
    "SubscribedUserTimeWindowSeconds": 10800,
    "VoiceUserMaxRequests": 50,
    "VoiceUserTimeWindowSeconds": 10800,
    "VoiceSubscribedUserMaxRequests": 200,
    "VoiceSubscribedUserTimeWindowSeconds": 10800
  },
  
  "Credits": {
    "CreditsPerConversation": 0,
    "InitialCreditsAmount": 1000
  },
  
  "LLMProviders": {
    "default": "openai",
    "providers": {
      "openai": {
        "providerType": "AzureOpenAI",
        "apiKey": "",
        "endpoint": "",
        "model": "gpt-4o",
        "deploymentName": "gpt-4o",
        "temperature": 0.7,
        "maxTokens": 2000
      }
    }
  },
  
  "LLMRegion": {
    "RegionToLLMsMap": {
      "DEFAULT": ["openai"],
      "CN": ["openai"],
      "CONSOLE": ["openai"],
      "CNCONSOLE": ["openai"]
    }
  },
  
  "Serilog": {
    "Properties": {
      "Application": "Aevatar.Silo"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "Path": "Logs/log-.log",
          "formatter": { "type": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
        }
      }
    ]
  },
  
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "Aevatar.Silo",
    "ServiceVersion": "1.0.0",
    "CollectorEndpoint": "http://localhost:4317"
  }
}

