{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Orleans": "Information",
      "Orleans.Runtime": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "AwsS3": {
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Region": "ap-northeast-1",
    "ContainerName": "godgpt-backend-staging"
  },
  
  "ConnectionStrings": {
    "Orleans": "mongodb://localhost:27017/AevatarBusiness"
  },
  
  "Orleans": {
    "ClusterId": "aevatar-cluster",
    "ServiceId": "aevatar-service",
    "SiloPort": 11111,
    "GatewayPort": 30000
  },
  
  "Storage": {
    "Provider": "MongoDB",
    "DatabaseName": "AevatarBusiness"
  },

  "MessageStream": {
    "Provider": "MassTransit"
  },
  "MassTransit": {
    "Stream": {
      "TopicPrefix": "agent-events",
      "TransportType": "Kafka",
      "RuntimeName": "Orleans",
      "TopicMapping": {
        "GodChat": "godgpt-chat-responses"
      },
      "Consumer": {
        "Enabled": true,
        "DispatchHandler": "GrainHandler",
        "IncludeTopicPrefix": true,
        "AutoScanAgentTopics": true
      },
      "Kafka": {
        "BootstrapServers": "localhost:9092",
        "ConsumerGroupId": "aevatar-agents-group"
      }
    }
  },
  
  "Streaming": {
    "Provider": "Kafka",
    "ProviderName": "AevatarAgents",
    "DefaultNamespace": "AevatarAgents",
    "GetQueueMsgsTimerPeriodMs": 50
  },
  
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "aevatar-silo-consumers",
    "PollTimeoutMs": 100,
    "GetQueueMsgsTimerPeriodMs": 50,
    "DefaultPartitions": 8,
    "DefaultReplicationFactor": 1,
    "Topics": {
      "AgentEvents": {
        "Name": "agent-events",
        "Partitions": 8,
        "ReplicationFactor": 1,
        "AutoCreate": true
      },
      "SystemEvents": {
        "Name": "system-events",
        "Partitions": 4,
        "ReplicationFactor": 1,
        "AutoCreate": true
      }
    }
  },
  
  "EventSourcing": {
    "Enabled": true,
    "SnapshotFrequency": 1,
    "Provider": "MongoDB"
  },
  
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexPrefix": "aevatar-state",
    "Username": "",
    "Password": ""
  },
  
  "CQRS": {
    "Projector": {
      "BatchSize": 50,
      "MaxBatchSize": 200,
      "FlushIntervalMs": 1000,
      "MaxRetryCount": 3
    }
  },
  
  "Speech": {
    "SubscriptionKey": "",
    "Region": "southeastasia",
    "Endpoint": "https://eastus.api.cognitive.microsoft.com/"
  },
  
  "AnonymousGodGPT": {
    "MaxChatCount": 100,
    "Enabled": true
  },
  
  "RateLimit": {
    "UserMaxRequests": 100,
    "UserTimeWindowSeconds": 10800,
    "SubscribedUserMaxRequests": 500,
    "SubscribedUserTimeWindowSeconds": 10800,
    "VoiceUserMaxRequests": 50,
    "VoiceUserTimeWindowSeconds": 10800,
    "VoiceSubscribedUserMaxRequests": 200,
    "VoiceSubscribedUserTimeWindowSeconds": 10800
  },
  
  "Credits": {
    "CreditsPerConversation": 0,
    "InitialCreditsAmount": 1000
  },
  
  "LLMProviders": {
    "default": "openai",
    "providers": {
      "openai": {
        "providerType": "AzureOpenAI",
        "apiKey": "",
        "endpoint": "",
        "model": "gpt-4o",
        "deploymentName": "gpt-4o",
        "temperature": 0.7,
        "maxTokens": 2000
      }
    }
  },
  
  "LLMRegion": {
    "RegionToLLMsMap": {
      "DEFAULT": ["openai"],
      "CN": ["openai"],
      "CONSOLE": ["openai"],
      "CNCONSOLE": ["openai"]
    }
  },
  
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Orleans": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/silo-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}

