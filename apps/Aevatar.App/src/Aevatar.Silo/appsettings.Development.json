{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Orleans": "Debug",
      "Orleans.Runtime": "Information",
      "Aevatar": "Debug"
    }
  },
  
  "Streaming": {
    "Provider": "OrleansStream",
    "ProviderName": "Default",
    "DefaultNamespace": "AevatarAgents",
    "GetQueueMsgsTimerPeriodMs": 50
  },
  
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ConsumerGroupId": "aevatar-silo-consumers",
    "PollTimeoutMs": 100,
    "GetQueueMsgsTimerPeriodMs": 50,
    "DefaultPartitions": 8,
    "DefaultReplicationFactor": 1,
    "ProducerAcks": "Leader",
    "ProducerLingerMs": 10,
    "ProducerBatchSize": 16384,
    "ProducerCompressionType": "Lz4",
    "ProducerMaxInFlight": 5,
    "Topics": {
      "AgentEvents": {
        "Name": "agent-events",
        "Partitions": 8,
        "ReplicationFactor": 1,
        "AutoCreate": true
      },
      "TypeA": {
        "Name": "AevatarAgents-TypeA",
        "Partitions": 8,
        "ReplicationFactor": 1,
        "AutoCreate": true
      },
      "TypeB": {
        "Name": "AevatarAgents-TypeB",
        "Partitions": 8,
        "ReplicationFactor": 1,
        "AutoCreate": true
      },
      "TypeC": {
        "Name": "AevatarAgents-TypeC",
        "Partitions": 8,
        "ReplicationFactor": 1,
        "AutoCreate": true
      },
      "TypeD": {
        "Name": "AevatarAgents-TypeD",
        "Partitions": 8,
        "ReplicationFactor": 1,
        "AutoCreate": true
      },
      "TypeE": {
        "Name": "AevatarAgents-TypeE",
        "Partitions": 8,
        "ReplicationFactor": 1,
        "AutoCreate": true
      }
    }
  },
  
  "EventSourcing": {
    "Enabled": true,
    "SnapshotFrequency": 1,
    "Provider": "OrleansStream"
  }
}

