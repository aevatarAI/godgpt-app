{
  "Serilog": {
    "Properties": {
      "Application": "Aevatar.AuthServer"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "Path": "Logs/log-.log",
          "formatter": { "type": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
        }
      }
    ]
  },
  "App": {
    "SelfUrl": "http://localhost:8001",
    "CorsOrigins": "http://localhost:8001,http://localhost:8082,https://localhost:44320,https://localhost:44345"
  },
  "ConnectionStrings": {
    "Default": "mongodb://localhost:27017/AevatarBusiness"
  },
  "AuthServer": {
    "Authority": "http://localhost:8001",
    "RequireHttpsMetadata": false,
    "SwaggerClientId": "App_Swagger"
  },
  "OpenIddict": {
    "Certificate": {
      "UseProductionCertificate": false,
      "CertificatePath": "openiddict.pfx",
      "CertificatePassword": ""
    }
  },
  "StringEncryption": {
    "DefaultPassPhrase": "ZFvZMGHBajaNe7Fc"
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:8001"
      }
    }
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "Aevatar.AuthServer",
    "ServiceVersion": "1.0.0",
    "CollectorEndpoint": "http://localhost:4317"
  }
}
