<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <RootNamespace>Aevatar.App.HttpApi.Host</RootNamespace>
    <AssemblyName>Aevatar.App.HttpApi.Host</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
    <None Remove="AGENT_RUNTIME.md" />
  </ItemGroup>

  <!-- Localization JSON files - copy to output -->
  <ItemGroup>
    <Content Update="Localization\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.UI" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aevatar.App.Application\Aevatar.App.Application.csproj" />
    <ProjectReference Include="..\Aevatar.App.HttpApi\Aevatar.App.HttpApi.csproj" />
    <ProjectReference Include="..\Aevatar.App.MongoDB\Aevatar.App.MongoDB.csproj" />
    <ProjectReference Include="..\Aevatar.App.Agents\Aevatar.App.Agents.csproj" />
  </ItemGroup>

  <!-- Aevatar Agent Framework -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.Abstractions\Aevatar.Agents.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.Core\Aevatar.Agents.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.AI.Core\Aevatar.Agents.AI.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.Runtime.Local\Aevatar.Agents.Runtime.Local.csproj" />
    <ProjectReference Include="..\..\..\..\src\Aevatar.Agents.Runtime.Orleans\Aevatar.Agents.Runtime.Orleans.csproj" />
    <ProjectReference Include="..\..\..\..\plugins\Aevatar.Agents.Plugins.CQRS\Aevatar.Agents.Plugins.CQRS.csproj" />
    <ProjectReference Include="..\..\..\..\plugins\Aevatar.Agents.Plugins.MassTransit\Aevatar.Agents.Plugins.MassTransit.csproj" />
  </ItemGroup>
  
  <!-- Payment Module -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\modules\Aevatar.Payment\Aevatar.Payment.csproj" />
    <ProjectReference Include="..\..\..\..\modules\Aevatar.Payment.Agents\Aevatar.Payment.Agents.csproj" />
  </ItemGroup>
  
  <!-- Orleans (for Orleans runtime option) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Client" />
    <PackageReference Include="Microsoft.Orleans.Core" />
    <PackageReference Include="Microsoft.Orleans.Serialization.Protobuf" />
    <PackageReference Include="Orleans.Providers.MongoDB" />
    <!-- Use custom Orleans.Streams.Kafka 9.3.0-net10.0 with Producer configuration support -->
    <PackageReference Include="Orleans.Streams.Kafka" />
  </ItemGroup>

  <!-- Core ABP Framework -->
  <ItemGroup>
    <PackageReference Include="Volo.Abp.Autofac" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" />
    <PackageReference Include="Volo.Abp.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Volo.Abp.Swashbuckle" />
    <PackageReference Include="Volo.Abp.BlobStoring.Aws" />
  </ItemGroup>

  <!-- Additional Tools -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Volo.Abp.Studio.Client.AspNetCore" />
    <PackageReference Include="AutoResponseWrapper" />
  </ItemGroup>
  
  <!-- Hangfire - Background Job Processing -->
  <ItemGroup>
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.Mongo" />
  </ItemGroup>

</Project>
