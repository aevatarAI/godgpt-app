{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Orleans": "Debug",
      "Aevatar": "Debug"
    }
  },
  
  "AgentRuntime": {
    "RuntimeType": "Orleans",
    "Orleans": {
      "ClusterId": "aevatar-cluster",
      "ServiceId": "aevatar-service",
      "SiloPort": 11111,
      "GatewayPort": 30000,
      "UseLocalhostClustering": true,
      "StreamProviderName": "Default"
    }
  },
  
  "Streaming": {
    "Provider": "OrleansStream",
    "DefaultNamespace": "AevatarAgents",
    "Topics": "AevatarAgents,AevatarAgents-Shared,AevatarAgents-TypeA,AevatarAgents-TypeB,AevatarAgents-TypeC,AevatarAgents-TypeD,AevatarAgents-TypeE"
  },
  
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "aevatar-client-consumers"
  },
  
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexPrefix": "aevatar-state"
  }
}
